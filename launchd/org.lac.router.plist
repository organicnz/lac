             then `lac daemon install` again. Never commit a token here. -->
        <key>LAC_BIND_ADDR</key>
        <string>127.0.0.1</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Users/organic/.cargo/bin:/Users/organic/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
