# LAC — Local Agentic Coding Environment Variables
# Copy to .env and adjust for your setup.

# Unified Gateway & Endpoints
LAC_GATEWAY_URL=http://127.0.0.1:8000/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
MLX_BASE_URL=http://127.0.0.1:8080/v1

# Primary Model (Qwen 3.8 27B)
PRIMARY_MODEL=qwen3.8-27b
OLLAMA_MODEL=qwen3.8-27b
LLAMA_MODEL=unsloth/Qwen3.6-27B-MTP-GGUF:Q8_0
MLX_MODEL=mlx-community/Qwen3.8-27B-4bit

# Storage Paths (Studio TB5 External / Internal Fallback)
HF_HOME=/Volumes/AIModels/hf
HF_HUB_CACHE=/Volumes/AIModels/hf/hub
OLLAMA_MODELS=/Volumes/AIModels/ollama

# Time Machine exclusions
TM_EXCLUDE="/Volumes/AIModels ~/.ollama ~/.cache/huggingface"

# Router Configuration
LAC_ROUTER_PORT=8000
LAC_BACKEND=auto